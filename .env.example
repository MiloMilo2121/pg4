# pg4 environment variables.
# Copy this file to `.env` and fill only the values you need. Missing optional
# keys do not fail startup; their providers stay unavailable and are logged at
# boot. Do not commit `.env`.

# ============================================================
# CORE
# ============================================================
# Runtime mode: development | production | test.
NODE_ENV=development

# Logger level: trace | debug | info | warn | error.
LOG_LEVEL=info

# Logger format: pretty for local development, json for production logs.
LOG_FORMAT=pretty

# ============================================================
# PIPELINE TUNING (override defaults from src/config/defaults.ts)
# ============================================================
# Maximum concurrent leads processed by enrich.
# CONCURRENCY=4

# Per-lead paid-provider ceiling in EUR. Paid providers still require
# --enable-paid at CLI time.
# COST_CEILING_EUR_PER_LEAD=0.10

# HTTP/provider timeout in milliseconds.
# REQUEST_TIMEOUT_MS=8000

# Free SERP routing: the low-yield `ddg_lite` provider is skipped for the
# italian_real_estate category profile (measured 0 conversions over 1,492
# leads). Set true to force the full free SERP set (debug / other verticals).
# SERP_EXPANDED_FREE_ENABLED=false

# ============================================================
# SERP PROVIDERS - paid (all optional, all gated by feature flag)
# ============================================================
# Serper.dev provider. Requires SERPER_ENABLED=true, SERPER_API_KEY, and
# CLI --enable-paid.
# SERPER_ENABLED=false
# SERPER_API_KEY=

# Reserved paid SERP provider flags. Leave disabled unless the provider is
# implemented and you have a valid key.
# EXA_ENABLED=false
# EXA_API_KEY=
# TAVILY_ENABLED=false
# TAVILY_API_KEY=
# PERPLEXITY_ENABLED=false
# PERPLEXITY_API_KEY=
# Sonar endpoint + model override (OpenAI-compatible baseURL).
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_MODEL=sonar

# ============================================================
# HTTP FALLBACKS - paid (all optional)
# ============================================================
# Reserved paid HTTP fallback flags. Leave disabled unless the provider is
# implemented and you have a valid key.
# BRIGHTDATA_ENABLED=false
# BRIGHTDATA_API_KEY=
# Token auth (preferred) + zone for the WEB_UNBLOCK role.
# BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_WEB_UNLOCKER_ZONE=
# FIRECRAWL_ENABLED=false
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Optional local/private Crawl4AI sidecar URL. No default is provided here.
# ORACLE_CRAWL4AI_URL=

# ============================================================
# LLM PROVIDERS - optional/reserved
# ============================================================
# Reserved LLM provider flags. The current default pg4 flow does not require
# an LLM key for the offline example or unit tests.
# OPENAI_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_ENABLED=false
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-4-8

# DeepSeek (LLM_CHEAP, OpenAI-compatible). PAID.
# DEEPSEEK_ENABLED=false
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Zhipu GLM / Z.AI (LLM_CHEAP, OpenAI-compatible). PAID (no assumed free tier).
# ZHIPU_ENABLED=false
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4

# Kimi / Moonshot (LLM_CHEAP, long-context, OpenAI-compatible). PAID.
# KIMI_ENABLED=false
# KIMI_API_KEY=
# KIMI_MODEL=kimi-k2
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Anthropic — default judge LLM for the judgment layer (L4/L5). PAID,
# disabled by default like every other paid provider (paid-gate OFF).
# ANTHROPIC_ENABLED=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# VPS recovery coordinator only. These are shell variables, not pg4 provider keys.
# GH_REPOSITORY=<owner>/<repo>
# GH_RECOVERY_TOKEN=
# DEEPSEEK_ENABLED=false
# DEEPSEEK_API_KEY=

# ============================================================
# ENRICHMENT EXTRAS
# ============================================================
# Optional contact enrichment provider flag. Leave disabled unless wired.
# HUNTER_ENABLED=false
# HUNTER_API_KEY=

# ------------------------------------------------------------
# FREE-GOLD DEEPENED extraction (FREE — direct_fetch only, no paid API)
# ------------------------------------------------------------
# When ON, after the homepage free-gold pass the pipeline also mines every
# lead's official_website multipage (homepage + /contatti + /chi-siamo).
# €0 in the free profile.
# DEEP_PAGES_ENABLED=false

# ------------------------------------------------------------
# INPUT-WEBSITE NAME-MATCH recovery (FREE — no fetch)
# ------------------------------------------------------------
# When ON, an input website whose domain embeds a distinctive company-name
# token is accepted after content-verify fails. Default OFF: it asserts a
# website without a live-body confirmation (precision rests on the token gate).
# INPUT_WEBSITE_NAME_MATCH_ENABLED=false

# ------------------------------------------------------------
# EMAIL inference + MX/SMTP handshake (FREE — DNS + SMTP, no mail sent)
# ------------------------------------------------------------
# Gate-A: an inferred email is personal data, so the master flag is OFF by
# default. Turning it on infers role/person inboxes on the verified company
# domain and fills email_inferred ONLY for an address the MX+SMTP RCPT handshake
# confirms deliverable (non-catch-all).
# EMAIL_INFERENCE_MX_ENABLED=false
# When ON, the SMTP RCPT probe runs by default (the verification). Set false to
# force MX-only mode (no outbound :25) where port 25 is blocked or to avoid RCPT
# probes — in MX-only mode nothing is ever asserted (precision-first).
# EMAIL_SMTP_PROBE_ENABLED=true
# Identity used in the handshake. Use a domain you control with valid rDNS for
# real runs to avoid being greylisted/blocked.
# EMAIL_SMTP_HELO_NAME=verifier.local
# EMAIL_SMTP_MAIL_FROM=verify@verifier.local
# EMAIL_INFERENCE_MAX_PROBES_PER_DOMAIN=3

# ------------------------------------------------------------
# OFFICIAL DATA enrich pass (CLI) — VAT/VIES + revenue/employees (fatturatoitalia)
# ------------------------------------------------------------
# Master switch for the guarded per-field official-data cascades on the enrich
# CLI path. OFF by default so a plain run stays offline + €0. When ON, the
# per-source flags below gate each lookup (both free public sources, default ON).
# All firmographics carry the franchise/wrong-entity guard + a good-citizen rate
# limiter. PEC by VAT (INI-PEC direct) is NOT wired — it is CAPTCHA-gated; the
# free PEC path is the on-page PEC from the website body, and full PEC-by-VAT
# comes from Openapi (paid, OPENAPI_ENABLED) when activated.
# OFFICIAL_DATA_ENRICH_ENABLED=false
# OFFICIAL_DATA_VIES_ENABLED=true
# OFFICIAL_DATA_FATTURATOITALIA_ENABLED=true

# ------------------------------------------------------------
# APIFY — external actor marketplace (PAID, off by default)
# ------------------------------------------------------------
# Google Maps uniquely supplies rating + reviews (the judgment A-axis) plus
# website recall / phone / socials for IT SMBs. Per-actor flags gate each:
# maps = GREEN (public business data); contact/facebook = YELLOW; instagram/
# tiktok = RED (higher ToS risk — conscious opt-in). Cost-gated like every paid call.
# APIFY_ENABLED=false
# APIFY_API_KEY=
# APIFY_MAPS_ENABLED=false
# APIFY_REGISTRO_ENABLED=false    # GREEN: Registro Imprese firmographics by P.IVA (~€0.018/co)
# APIFY_CONTACT_ENABLED=false
# APIFY_FACEBOOK_ENABLED=false
# APIFY_INSTAGRAM_ENABLED=false   # RED: Instagram ToS forbids scraping
# APIFY_TIKTOK_ENABLED=false      # RED: TikTok ToS forbids scraping
# Bilanci + email-verify actors: no default actor id — the operator picks the
# marketplace actor, so ACTOR_ID is required to enable them.
# APIFY_BILANCI_ENABLED=false
# APIFY_BILANCI_ACTOR_ID=
# APIFY_EMAIL_VERIFY_ENABLED=false
# APIFY_EMAIL_VERIFY_ACTOR_ID=
# Portal actors (immobiliare.it / wikicasa ads + listings) with id overrides
# so they survive marketplace drift without a code change.
# APIFY_PORTAL_IMMOBILIARE_ENABLED=false
# APIFY_PORTAL_IMMOBILIARE_ACTOR_ID=
# APIFY_PORTAL_IMMOBILIARE_ADS_ENABLED=false
# APIFY_PORTAL_IMMOBILIARE_ADS_ACTOR_ID=
# APIFY_PORTAL_WIKICASA_ENABLED=false
# APIFY_PORTAL_WIKICASA_ACTOR_ID=

# ------------------------------------------------------------
# JUDGMENT-LAYER SOURCES (all disabled by default; presence-before-depth)
# ------------------------------------------------------------
# Google Places API — official source for Maps/GBP/reviews/hours.
# GOOGLE_PLACES_ENABLED=false
# GOOGLE_PLACES_API_KEY=
# Ad transparency libraries (Meta Ad Library / Google Ads Transparency).
# ADLIB_ENABLED=false
# ADLIB_API_KEY=

# ------------------------------------------------------------
# OPENAPI.COM — official Italian company registry (PAID, off by default)
# ------------------------------------------------------------
# Used ONLY for top companies on explicit request (activation layer — see
# docs/openapi_layer_rules.md). Base URL switches prod/sandbox.
# OPENAPI_ENABLED=false
# OPENAPI_API_KEY=
# OPENAPI_BASE_URL=https://company.openapi.com

# ------------------------------------------------------------
# PERPLEXITY entity-resolution (last-resort discovery, PAID)
# ------------------------------------------------------------
# Reuses the wired Perplexity LLM (Sonar) to resolve website/social/VAT for leads
# the free ladder failed, with a citation + verifyCandidates guard. Needs
# PERPLEXITY_ENABLED + PERPLEXITY_API_KEY (above). [not yet wired — next increment]
# PERPLEXITY_RESOLVE_ENABLED=false

# ------------------------------------------------------------
# DEFAULT-CAP PAID ESCALATION (WS-E)
# ------------------------------------------------------------
# Flip paid ON by default at a small HARD per-lead cap, so the engine auto-
# escalates to Apify/Perplexity on leads the free ladder did not resolve. The
# router's run-ceiling + per-lead budget still enforce the cap; degrades to free
# (warn, never breaks) if no usable paid key. Default OFF in code (offline-first).
# PAID_DEFAULT_ON=false
# DEFAULT_PAID_CAP_EUR_PER_LEAD=0.015

# ============================================================
# BROWSER
# ============================================================
# Playwright live browser mode. Fixture mode and unit tests do not launch it.
# PLAYWRIGHT_HEADLESS=true

# ============================================================
# LOCAL DASHBOARD API (single-tenant development adapter)
# ============================================================
# This API has no authentication and is intentionally loopback-only. It accepts
# only 127.0.0.1, ::1, or localhost for PG4_API_HOST; expose a separate,
# authenticated adapter instead of binding this dev server to a LAN/public IP.
# PG4_API_PORT=8787
# PG4_API_HOST=127.0.0.1
# Seed file override for the dev API (`pnpm demo` sets it to the fictional
# demo dataset). Defaults to the real free-gold seed in output/.
# PG4_SEED_FILE=examples/demo/companies.jsonl
# Optional additional browser origin for a local dashboard on a non-default port.
# Its host is also accepted in the Host header; any other Host that is not
# localhost/127.0.0.1/[::1] on PG4_API_PORT gets 403 (DNS-rebinding guard).
# PG4_API_ALLOWED_ORIGIN=http://localhost:3001

# ============================================================
# TESTING
# ============================================================
# Set to 1 to enable network-touching smoke tests.
# RUN_SMOKE=0

# ============================================================
# OBSERVABILITY (Phase A)
# ============================================================
# Per-run log file (structured JSONL). When unset, every CLI run writes
# <out>.log.jsonl alongside its outputs. Set a path to centralize, or
# LOG_FILE=off to disable file logging entirely.
# LOG_FILE=

# Operator notifications: local (default — structured log line + best-effort
# macOS notification) | off.
# NOTIFY=local

# ============================================================
# COMPLIANCE (Phase D)
# ============================================================
# Do-not-contact suppression list (CSV: phone,vat,reason,date). Also
# resolvable via --suppression-list flag or an auto-discovered
# suppression.csv next to the run output.
# SUPPRESSION_LIST=

# Delete output artifacts older than N days at run start. Default: unset
# (nothing is ever deleted). The retention period is a GDPR decision —
# see docs/gdpr_posture.md.
# RETENTION_DAYS=
